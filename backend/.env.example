ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot_dev@localhost:5432/careerpilot

# Supabase Auth project. The API verifies access tokens locally against the
# asymmetric signing keys at ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# Set SUPABASE_JWKS_URL only to override that discovery URL.
# Do not set the service-role key or the legacy JWT secret.
SUPABASE_URL=https://kcrtedhezyovfygfotia.supabase.co
SUPABASE_JWKS_URL=

# CV writing assistance. The key stays on the API service and is never sent to the browser.
# Leave it blank to disable AI: the CV Studio buttons show "AI not configured" and the
# AI routes return 503. ANTHROPIC_MODEL defaults to claude-sonnet-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Per-user spend for the current UTC day, and app-wide spend for the current UTC month.
ANTHROPIC_DAILY_USER_CAP_USD=2
ANTHROPIC_MONTHLY_CAP_USD=50

# Job discovery. Keys stay on the API service and are never sent to the browser.
# Leave a key blank to show that provider as "not configured"; it is then skipped.
# Adzuna: register at https://developer.adzuna.com/ and copy the application ID and key.
# New Zealand search uses country code nz.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: request a New Zealand key at https://nz.jooble.org/api/about.
# A key from https://jooble.org/api/about returns US listings only.
# The documented request host is https://jooble.org/api/{key}. Set JOOBLE_API_BASE
# only to another official Jooble host, such as https://nz.jooble.org/api.
JOOBLE_API_KEY=
JOOBLE_API_BASE=
